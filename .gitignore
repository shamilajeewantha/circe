# Python cache
__pycache__/
*.pyc
*.pyo

# Secrets — API keys, never committed
.env

# Controller runtime logs
controller/logs/

# Analysis output files — contain raw captured traffic and personal phone data
capture_analysis.txt
drone_packets.txt

# Packet captures — contain raw WiFi traffic, potentially sensitive
*.pcap
*.pcapng
*.pcap.gz

# pcap_analyzer.py decode-frame output — generated, not source
DM002HW_controller_tests/decoded_frame_*.png
DM002HW_controller_tests/video_debug/

# applog.py runtime log file — generated, not source
DM002HW_controller_tests/app_logs/

# Optical-flow controller (circe_v1) runtime output — generated, not source.
# Anywhere these appear: flow session logs/frames, video debug captures, app logs.
flow_debug/
video_debug/
app_logs/

# ============================================================================
# ML datasets & training output — large and/or regenerable, NOT source.
# Pattern used below: `<dir>/*` + `!<dir>/README.md` ignores the folder's
# CONTENTS but keeps the folder itself in git via its committed README (git
# needs `/*`, not `/`, for the `!README.md` re-include to work).
# ============================================================================

# Local YOLO datasets dir (Ultralytics auto-downloads coco8 etc. here)
datasets/*
!datasets/README.md

# dataset_creation working data (inputs/json/outputs) — regenerable
dataset_creation/data/*
!dataset_creation/data/README.md

# Source datasets for the merge pipeline (~7 GB of images) — keep the README index
model_training/datasets/*
!model_training/datasets/README.md

# Merged 11-class YOLO dataset (~4 GB) — regenerate via model_training/pipeline
model_training/merged/*
!model_training/merged/README.md

# Sample images for predict.py smoke tests — regenerable/downloadable
model_training/sample_downloaded_nuts/*
!model_training/sample_downloaded_nuts/README.md
model_training/sample_downloaded_nuts_clean/*
!model_training/sample_downloaded_nuts_clean/README.md
model_training/sample_images/*
!model_training/sample_images/README.md

# Ultralytics train/val/predict output (weights, plots, logs) — regenerated by the scripts
model_training/runs/*
!model_training/runs/README.md

# Downloaded pretrained base weights — re-downloaded on demand, not source.
# (Does NOT affect drone_detection/best.pt, which is intentionally LFS-tracked.)
model_training/yolo26n.pt

# Dataset-analysis report: keep the figure PNGs + stats.json + the small
# preliminary_report.html, but ignore the heavy REGENERABLE blobs (all
# reproducible via model_training/pipeline/make_report.py).
model_training/reports/index.html
model_training/reports/dropped_images.csv
model_training/reports/embedding.json
model_training/reports/*_run.log

# circe_v3 sim — slam_server.py smoke-test keyframes, generated debug output, not source
circe_v3/simulation/slam_host/slam_host_keyframes/
