<?xml version="1.0"?>
<package format="3">
  <name>circe_rover_description</name>
  <version>0.1.0</version>
  <description>URDF/xacro for the circe low-profile skid-steer inspection rover
    (horizontal camera, IMU, ToF) + Gazebo Harmonic sensor/DiffDrive plugins.</description>
  <maintainer email="shamilajeewantha1@gmail.com">Shamila</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>
