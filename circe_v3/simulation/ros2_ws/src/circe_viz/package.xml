<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>circe_viz</name>
  <version>0.1.0</version>
  <description>
    Real-time Gradio 3D viewer for the circe rover: live VGGT map, inspection
    surfels (covered/gap), fog frontier, robot pose/trajectory and next station.
    Subscribes to the circe ROS topics and refreshes a gr.Model3D on a timer.
  </description>
  <maintainer email="shamilajeewantha1@gmail.com">Shamila</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- gradio + trimesh are pip deps (not rosdep keys); install into the ROS env -->

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
