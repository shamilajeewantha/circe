<?xml version="1.0" ?>
<!-- Local fork of turtlebot4_gz_bringup's maze.sdf (apt: ros-jazzy-turtlebot4-simulator).
     Two changes vs stock, both required:
       1. Sensors system (gz-sim-sensors-system) UNCOMMENTED - drives camera +
          gpu_lidar; stock ships it disabled so sensors advertise topics but
          never publish.
       2. Imu system (gz-sim-imu-system) ADDED - stock has it nowhere at all.

     WHY MAZE AND NOT DEPOT (BUILD_GUIDE 3/8 leaves the world to the sim box):
     depot.sdf is UNUSABLE for navigation. Its Fuel model has 16 visuals but a
     single collision, and that collision is just a 100x100 m ground plane - no
     wall or crate collision geometry at all. The rover drives straight through
     the building and wanders to the edge of the plane, which is what made the
     map grow unbounded over empty space, kept surfels at ~150, and left
     coverage at covered=0 (the 8-shot rings were firing in open air). It also
     desynced the ToF, since gpu_lidar raycasts the RENDER scene and so "saw"
     walls that physics let the rover pass through.
     maze.sdf instead defines 41 visuals with 41 matching collisions inline
     (real box walls) and pulls in NO Fuel models, so nothing can silently fail
     to download. It is also more occluded/non-convex, which is what the fog
     frontier and detection-gap clustering actually need to be non-trivial. -->
<sdf version='1.8'>
    <world name='maze'>
        <physics name='1ms' type='ignored'>
            <max_step_size>0.003</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
        </physics>

        <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
        <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
        <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
        <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system" />
        <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system" />

        <light name='sun' type='directional'>
            <cast_shadows>1</cast_shadows>
            <pose>0 0 10 0 -0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.90000000000000002</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
            <spot>
                <inner_angle>0</inner_angle>
                <outer_angle>0</outer_angle>
                <falloff>0</falloff>
            </spot>
        </light>
        <gravity>0 0 -9.8</gravity>
        <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
        <atmosphere type='adiabatic' />
        <scene>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0.7 0.7 0.7 1</background>
            <shadows>1</shadows>
        </scene>
        <model name='ground_plane'>
            <static>1</static>
            <link name='link'>
                <collision name='collision'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <surface>
                        <friction>
                            <ode />
                        </friction>
                        <bounce />
                        <contact />
                    </surface>
                </collision>
                <visual name='visual'>
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.427 0.107 0.107 1</ambient>
                        <diffuse>0.950 0.237 0.237 1</diffuse>
                        <specular>0.1 0.1 0.1 1</specular>
                        <pbr><metal>
                            <albedo_map>textures/feature_wall.png</albedo_map>
                            <roughness>0.9</roughness>
                            <metalness>0.0</metalness>
                        </metal></pbr>
                    </material>
                    <plugin name='__default__' filename='__default__' />
                </visual>
            </link>
            <plugin name='__default__' filename='__default__' />
            <pose>0 0 0 0 -0 0</pose>
        </model>

